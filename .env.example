# Copia este archivo como .env y cambia los valores:
#   cp .env.example .env
# El archivo .env NO se sube a GitHub (está en .gitignore).

POSTGRES_DB=notasdb
POSTGRES_USER=notas_user
POSTGRES_PASSWORD=cambia_esta_clave

# Puerto del equipo anfitrión donde quedará la API (opcional, por defecto 5000)
APP_PORT=5000
